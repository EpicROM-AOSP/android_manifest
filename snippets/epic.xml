<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="epic"
          fetch="https://github.com/EpicROM-AOSP"
          revision="14" />	  

  <remote  name="PixelOS-Gitlab"
           fetch="https://gitlab.com/PixelOS-AOSP"
           revision="refs/heads/fourteen" />

  <remote  name="PixelOS-Devices-Gitlab"
           fetch="https://gitlab.com/PixelOS-Devices"
           revision="refs/heads/fourteen" />

  <!-- Rootdir -->
  <project path="bionic" name="android_bionic" groups="pdk" remote="epic" />
  <project path="epic-maintainers" name="epic-maintainers" remote="epic" />

  <!-- Bootable -->
  <project path="bootable/recovery" name="android_bootable_recovery" groups="pdk" remote="epic" />

  <!-- Build -->
  <project path="build/make" name="android_build" groups="pdk" remote="epic">
    <linkfile dest="build/CleanSpec.mk" src="CleanSpec.mk" />
    <linkfile dest="build/buildspec.mk.default" src="buildspec.mk.default" />
    <linkfile dest="build/core" src="core" />
    <linkfile dest="build/envsetup.sh" src="envsetup.sh" />
    <linkfile dest="build/target" src="target" />
    <linkfile dest="build/tools" src="tools" />
  </project>
  <project path="build/soong" name="android_build_soong" groups="pdk,tradefed" remote="epic">
    <linkfile dest="Android.bp" src="root.bp" />
    <linkfile dest="bootstrap.bash" src="bootstrap.bash" />
  </project>

  <!-- External -->
  <project path="external/jemalloc_new" name="android_external_jemalloc_new" groups="pdk" remote="epic" />
  <project path="external/FadingEdgeLayout" name="android_external_FadingEdgeLayout" remote="epic" />

  <!-- Frameworks -->
  <project path="frameworks/av" name="android_frameworks_av" groups="pdk" remote="epic" />
  <project path="frameworks/base" name="android_frameworks_base" groups="pdk-cw-fs,pdk-fs" remote="epic" />
  <project path="frameworks/native" name="android_frameworks_native" groups="pdk" remote="epic" />

  <!-- Hardware -->
  <project path="hardware/google/pixel-sepolicy" name="android_hardware_google_pixel-sepolicy" groups="generic_fs,pixel" remote="epic" />
  <project path="hardware/xiaomi" name="android_hardware_xiaomi" groups="pdk" remote="epic" />

  <!-- Packages -->
  <project path="packages/apps/EpicDumpster" name="android_packages_apps_EpicDumpster" remote="epic">
    <linkfile src="res" dest="packages/apps/Settings/res-dumpster" />
    <linkfile src="src" dest="packages/apps/Settings/src_dumpster" />
    </project>
  <project path="packages/apps/EpicWallpaperStub" name="android_packages_apps_EpicWallpaperStub" remote="epic" />
  <project path="packages/apps/Nfc" name="android_packages_apps_Nfc" groups="apps_nfc,pdk-fs" remote="epic" />
  <project path="packages/apps/ParanoidSense" name="android_packages_apps_ParanoidSense" remote="epic" />
  <project path="packages/overlays/Themes" name="android_packages_overlays_Themes" remote="epic" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" groups="pdk-fs" remote="epic" />
  <project path="packages/modules/Connectivity" name="android_packages_modules_Connectivity" groups="pdk" remote="epic" />
  <project path="packages/services/Telecomm" name="android_packages_services_Telecomm" remote="epic" />

  <!-- System -->
  <project path="system/core" name="android_system_core" groups="pdk" remote="epic" />
  <project path="system/sepolicy" name="android_system_sepolicy" groups="pdk" remote="epic" />
  <project path="system/update_engine" name="android_system_update_engine" groups="pdk" remote="epic" />

  <!-- Begin Extras -->

  <!-- Device -->
  <project path="device/lineage/sepolicy" name="android_device_lineage_sepolicy" remote="epic" />

  <!-- Vendor -->
  <project path="vendor/aosp" name="android_vendor_epic" remote="epic" />
  <project path="vendor/support" name="android_vendor_support" remote="epic" />
  <project path="vendor/gms" name="vendor_gms" clone-depth="1" remote="PixelOS-Devices-Gitlab" />

</manifest>
